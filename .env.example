# Porta de execução do servidor
PORT=3000

# Configurações do Kommo CRM
# Exemplo: se sua URL for https://suaempresa.kommo.com, o subdomínio é "suaempresa"
KOMMO_SUBDOMAIN=suaempresa
# Token de longa duração gerado em: Configurações > Integrações > Criar Integração
KOMMO_ACCESS_TOKEN=seu_access_token_do_kommo_aqui

# IDs das etapas de destino (Execute 'npm run list-stages' para descobrir os IDs)
STAGE_POSITIVO_ID=00000000
STAGE_NEGATIVO_ID=00000000
STAGE_HUMANO_ID=00000000

# Tempo de espera (em milissegundos) para agrupar áudios/mensagens seguidas do mesmo lead (25s padrão)
BUFFER_TIMEOUT_MS=25000

# Chave de API da OpenAI (para Whisper e GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...
